'use strict';
const $=s=>document.querySelector(s), $$=s=>Array.from(document.querySelectorAll(s));
const slides=$$('.slide');let current=0,flow=false,toastHandle;
function toast(text){const el=$('#toast');el.textContent=text;el.hidden=false;clearTimeout(toastHandle);toastHandle=setTimeout(()=>el.hidden=true,2800)}
function setPressed(buttons,selected){buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===selected)))}
function detail(el,title,text){el.querySelector('b').textContent=title;el.querySelector('p').textContent=text}
function formatTime(seconds){seconds=Math.max(0,Math.floor(seconds));return String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0')}
slides.forEach((s,i)=>{
 s.querySelector('.notes-content').innerHTML=speech[i].notes;
 const b=document.createElement('button');b.textContent=String(i+1).padStart(2,'0');b.title=s.dataset.title;b.setAttribute('aria-label',`${i+1}. ${s.dataset.title}`);b.addEventListener('click',()=>go(i));$('#rail').append(b);
 const card=document.createElement('button');const small=document.createElement('small');small.textContent=String(i+1).padStart(2,'0')+' · '+speech[i].time;const title=document.createElement('b');title.textContent=s.dataset.title;const duration=document.createElement('small');duration.textContent=speech[i].minutes+' мин';card.append(small,title,duration);card.addEventListener('click',()=>{$('#contentsDialog').close();go(i)});$('#overviewGrid').append(card);
 s.querySelector('.notes').addEventListener('toggle',()=>{if(i===current)syncNotes()});
});
function syncNotes(){const open=flow?slides[current].querySelector('.notes').open:readerVisible;$('#notesBtn').setAttribute('aria-pressed',String(open));$('#notesBtn').classList.toggle('on',open);$('#notesBtn').title=flow?'Текст текущего блока — N':open?'Скрыть текст и увеличить схему — N':'Показать текст рядом со схемой — N'}
function updateNav(){
 $$('#rail button').forEach((b,i)=>{if(i===current)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');b.classList.toggle('past',i<current)});
 $$('#overviewGrid button').forEach((b,i)=>b.classList.toggle('on',i===current));
 $('#prevBtn').disabled=current===0;$('#nextBtn').disabled=current===slides.length-1;$('#pageCounter').textContent=String(current+1).padStart(2,'0')+' / 12';$('#progressBar').style.width=((current+1)/slides.length*100)+'%';$('#nextLabel').textContent=current<11?'Далее · '+slides[current+1].dataset.title:'30 минут · спасибо за внимание';syncNotes();
}
function go(index,scroll=true){
 current=Math.max(0,Math.min(slides.length-1,index));slides.forEach((s,i)=>s.classList.toggle('is-active',i===current));updateNav();syncReader();requestStageFit();
 try{history.replaceState(null,'','#block-'+(current+1))}catch{}
 if(scroll){if(flow)slides[current].scrollIntoView({behavior:'auto',block:'start'});else window.scrollTo({top:0,behavior:'auto'})}
 $('#slideAnnouncement').textContent=`Блок ${current+1} из 12. ${slides[current].dataset.title}`;
}
$('#prevBtn').addEventListener('click',()=>go(current-1));$('#nextBtn').addEventListener('click',()=>go(current+1));
$('#contentsBtn').addEventListener('click',()=>$('#contentsDialog').showModal());$('#helpBtn').addEventListener('click',()=>$('#helpDialog').showModal());
$('#lessonImageBtn').addEventListener('click',()=>$('#lessonDialog').showModal());
$('#sourcesBtn').addEventListener('click',()=>$('#sourcesDialog').showModal());
$$('[data-close]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog').close()));
$$('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}}));
$('#viewBtn').addEventListener('click',()=>{flow=!flow;document.body.dataset.view=flow?'flow':'present';$('#viewBtn').setAttribute('aria-pressed',String(flow));$('#viewBtn').classList.toggle('on',flow);$('#viewBtn').title=flow?'Показать по одному блоку':'Показать все блоки';$('#viewBtn').querySelector('.wide').textContent=flow?'Выступление':'Лента';go(current)});
$('#notesBtn').addEventListener('click',()=>{if(flow){const n=slides[current].querySelector('.notes');n.open=!n.open}else setReaderVisible(!readerVisible)});
async function fullscreen(){try{if(document.fullscreenElement)await document.exitFullscreen();else if(document.documentElement.requestFullscreen)await document.documentElement.requestFullscreen();else toast('Полный экран включается через меню браузера')}catch{toast('Полный экран недоступен в этом окне. Откройте страницу отдельно.')}}
$('#fullscreenBtn').addEventListener('click',fullscreen);document.addEventListener('fullscreenchange',()=>$('#fullscreenBtn').classList.toggle('on',!!document.fullscreenElement));
$('#printBtn').addEventListener('click',()=>{$('#helpDialog').close();window.print()});
document.addEventListener('keydown',e=>{
 if(e.ctrlKey||e.altKey||e.metaKey||/INPUT|TEXTAREA|SELECT/.test(e.target.tagName)||e.target.isContentEditable)return;
 if($$('dialog').some(d=>d.open))return;
 if(!flow&&readerVisible&&['PageDown','PageUp'].includes(e.key)){e.preventDefault();const reader=$('#readerScroll');reader.scrollTop+=(e.key==='PageDown'?1:-1)*reader.clientHeight*.8;updateReadingProgress();return}
 if(['ArrowRight','PageDown'].includes(e.key)){e.preventDefault();go(current+1)}
 if(['ArrowLeft','PageUp'].includes(e.key)){e.preventDefault();go(current-1)}
 if(e.target===$('#readerScroll')&&['Home','End'].includes(e.key)){e.preventDefault();$('#readerScroll').scrollTop=e.key==='Home'?0:$('#readerScroll').scrollHeight;updateReadingProgress();return}
 if(e.key==='Home'){e.preventDefault();go(0)}if(e.key==='End'){e.preventDefault();go(11)}
 if(e.key.toLowerCase()==='f'){e.preventDefault();fullscreen()}
 if(e.key.toLowerCase()==='n'){e.preventDefault();$('#notesBtn').click()}
 if(e.key.toLowerCase()==='o'){e.preventDefault();$('#contentsBtn').click()}
});
window.addEventListener('hashchange',()=>{const m=location.hash.match(/^#block-(\d+)$/);if(m)go(Number(m[1])-1)});
if('IntersectionObserver' in window){const obs=new IntersectionObserver(entries=>{if(!flow)return;for(const e of entries)if(e.isIntersecting){current=slides.indexOf(e.target);updateNav()}},{rootMargin:'-20% 0px -65% 0px',threshold:0});slides.forEach(s=>obs.observe(s))}
$$('[data-inspect]').forEach(b=>{if(!b.hasAttribute('aria-pressed'))b.setAttribute('aria-pressed','false');b.addEventListener('click',()=>{const s=b.closest('.slide');setPressed(Array.from(s.querySelectorAll('[data-inspect]')),b);detail(s.querySelector('.inspect'),b.dataset.title,b.dataset.text)})});
const reflectState={scale:0,depth:0,subject:0};
const reflectionPrompts=[
 [
  ['Какой факт изменил моё объяснение в ходе действия?','Как переживание повлияло на моё действие в этой ситуации?','В какой момент я заметил изменение своего участия?'],
  ['Каким способом я проверяю основания своего объяснения?','Как я различаю чувство, оценку и основание своего решения?','Как я организую условия, в которых могу удерживать присутствие?'],
  ['Как устроен мой способ выбора оснований для проверки?','Как я определяю, каким способом исследовать свои переживания?','Как я выбираю сам способ наблюдения за своим присутствием?']
 ],
 [
  ['Какой факт изменил общее объяснение группы?','Как переживания участников повлияли на совместное действие?','В какой момент изменилось участие людей в общей работе?'],
  ['Каким способом группа сопоставляет и проверяет объяснения?','Как группа различает переживания, оценки и разногласия?','Как устроено распределение участия и внимания в группе?'],
  ['Как группа выбирает основания и процедуры своей рефлексии?','Как группа определяет способы исследования общей эмоциональной ситуации?','Как группа проверяет сам способ наблюдения за участием своих членов?']
 ],
 [
  ['Как общественная практика обнаружила ограничение принятого объяснения?','Как общественные переживания проявились в конкретных решениях?','Какие формы участия стали заметны в рассматриваемой ситуации?'],
  ['Какие институты и процедуры поддерживают проверку общих представлений?','Какие нормы определяют выражение и осмысление общественных переживаний?','Как общественные нормы организуют возможности присутствия и участия?'],
  ['Как общество определяет допустимые основания проверки своих представлений?','Как формируются способы общественного осмысления переживаний?','Как выбираются сами критерии, по которым судят об общественном участии?']
 ],
 [
  ['Какой факт не укладывается в представление и требует его изменения?','Как переживание встречи с реальностью изменило действие?','Как столкновение с происходящим изменило моё присутствие в ситуации?'],
  ['Каким способом мы различаем свойства реальности и собственной модели?','Как мы соотносим переживание события с тем, что произошло?','Каким способом мы отличаем присутствие в ситуации от представления о нём?'],
  ['На каком основании мы выбираем способ соотнесения модели с реальностью?','Каковы границы самого способа осмысления переживания реальности?','Как проверяется основание, на котором мы определяем присутствие?']
 ]
];
$$('.axis button').forEach(b=>b.addEventListener('click',()=>{
 const axis=b.closest('.axis');reflectState[axis.dataset.axis]=+b.dataset.value;
 setPressed(Array.from(axis.querySelectorAll('button')),b);
 const a=reflectState;$('#reflectionQuestion').textContent=reflectionPrompts[a.scale][a.depth][a.subject];
 $('#reflectionLabels').textContent=$$('.axis button[aria-pressed="true"]').map(x=>x.textContent).join(' · ');
}));

const methods=[
 {title:'Метод опытного опробирования',steps:['Прояснить смысл и сопоставить представления','Определить предполагаемую функцию','Опробовать и наблюдать последствия','Принять, уточнить или отклонить'],result:'Продукт: обоснованное изменение способа работы.'},
 {title:'Метод структурирования идеалов',steps:['Восстановить повторяющиеся сценарии действия','Выявить значимый внутренний фактор и ценность','Сформулировать желаемое состояние — идеал','Сопоставить с другими идеалами и определить место'],result:'Продукт: уточнённая самим участником структура ориентиров.'},
 {title:'Рефлексивная реконструкция',steps:['Восстановить действие и прежний способ','Найти расхождение и изменившиеся условия','Построить новую норму или способ','Представить схему и опробовать её в действии'],result:'Продукт: новый способ, проверенный в конкретной ситуации.'}
];
$$('[data-method]').forEach(b=>b.addEventListener('click',()=>{
 setPressed($$('[data-method]'),b);const m=methods[+b.dataset.method];
 $('#methodTitle').textContent=m.title;$('#methodResult').textContent=m.result;
 const list=$('#methodSteps');list.replaceChildren();m.steps.forEach(text=>{const li=document.createElement('li');li.textContent=text;list.append(li)});
}));

const cases=[
 ['Выявление основания действия','Зафиксировать своё объяснение признаков животных','Исходная версия и её обоснование','«Животные передвигаются»','Возможное первоначальное правило ученика. Самостоятельность его построения и объём помощи нужно фиксировать отдельно.'],
 ['Обнаружение границы прежней модели','Рассмотреть взрослых губок и коралловых полипов','Реакция на контрпример и характер поддержки','Прикреплённое животное не укладывается в правило','Контрпример обнаруживает недостаточность одного признака. Нужна предметная работа с основаниями классификации.'],
 ['Перестройка основания и проверка переноса','Уточнить признаки и рассмотреть новый случай','Новая версия, аргументы и объём помощи','«Одного признака недостаточно. Проверю другие основания»','Пример предполагаемого рассуждения. Перенос способа в новую задачу предстоит исследовать; схема не сообщает об уже доказанном эффекте.']
];
$$('[data-case]').forEach(b=>b.addEventListener('click',()=>{
 setPressed($$('[data-case]'),b);const data=cases[+b.dataset.case];
 ['caseConcept','caseAction','caseEvidence','caseExample','caseNote'].forEach((id,i)=>$('#'+id).textContent=data[i]);
}));

const statuses=[
 ['Работающая основа',['Учебные материалы','Личные кабинеты','Расписание','Журнал баллов','Базовые самостоятельные']],
 ['Качество и сопровождение',['Обновление уроков','Расширенная обратная связь','Общие повторения','Тьюторский модуль']],
 ['Индивидуальные программы',['Самостоятельное обучение','Сохранение хороших материалов','Постепенное добавление элементов','Сохранность результатов']]
];
$$('[data-status]').forEach(b=>b.addEventListener('click',()=>{
 setPressed($$('[data-status]'),b);const data=statuses[+b.dataset.status],el=$('#statusBody');el.replaceChildren();
 const h=document.createElement('h3');h.textContent=data[0];const items=document.createElement('div');items.className='status-items';
 data[1].forEach(x=>{const span=document.createElement('span');span.textContent=x;items.append(span)});el.append(h,items);
}));
let talkRunning=false,talkElapsed=0,talkStarted=0;
function talkSeconds(){return talkElapsed+(talkRunning?(Date.now()-talkStarted)/1000:0)}
function renderTalk(){const sec=talkSeconds();$('#talkTime').textContent=formatTime(sec);$('#talkClock').classList.toggle('over',sec>=1800);$('#timerBtn').textContent=talkRunning?'Ⅱ':'▶';$('#timerBtn').setAttribute('aria-label',talkRunning?'Поставить таймер доклада на паузу':'Запустить таймер доклада')}
$('#timerBtn').addEventListener('click',()=>{if(talkRunning){talkElapsed=talkSeconds();talkRunning=false}else{talkStarted=Date.now();talkRunning=true}renderTalk()});
$('#resetTimer').addEventListener('click',()=>{talkRunning=false;talkElapsed=0;renderTalk()});

setInterval(()=>{if(talkRunning)renderTalk()},250);
// The script stays visible while its own scroll container moves.
let readerVisible=true,readerFont=21,readerShare=38,renderedReader=-1,fitPending=false;
const readingPositions=new Map();
try{
 const saved=JSON.parse(localStorage.getItem('subjectivity-reader-layout')||'{}');
 if(Number.isFinite(saved.font))readerFont=Math.min(30,Math.max(16,saved.font));
 if(Number.isFinite(saved.share))readerShare=Math.min(50,Math.max(30,saved.share));
}catch{}
function saveReaderSettings(){try{localStorage.setItem('subjectivity-reader-layout',JSON.stringify({font:readerFont,share:readerShare}))}catch{}}
function applyReaderSettings(){
 document.documentElement.style.setProperty('--reader-font',readerFont+'px');
 document.documentElement.style.setProperty('--reader-share',readerShare+'%');
 $('#fontSize').textContent=String(readerFont);$('#fontDown').disabled=readerFont<=16;$('#fontUp').disabled=readerFont>=30;
 $('#readerWidth').value=String(readerShare);$('#readerWidth').setAttribute('aria-valuetext',readerShare+' процентов ширины окна');
 requestStageFit();requestAnimationFrame(updateReadingProgress);
}
function updateReadingProgress(){
 const el=$('#readerScroll'),distance=el.scrollHeight-el.clientHeight;
 const percent=distance>0?Math.round(Math.max(0,Math.min(1,el.scrollTop/distance))*100):100;
 $('#readerProgressBar').style.width=percent+'%';$('#readerProgressValue').textContent=percent+'%';
}
function syncReader(){
 if(renderedReader!==current){
  if(renderedReader>=0)readingPositions.set(renderedReader,$('#readerScroll').scrollTop);
  renderedReader=current;
  $('#readerBlock').textContent='Текст доклада · '+String(current+1).padStart(2,'0')+' / 12';
  $('#readerTitle').textContent=speech[current].title;
  $('#readerTime').textContent=speech[current].time+' · '+speech[current].minutes+' мин';
  $('#readerText').innerHTML=speech[current].notes;
  $('#readerScroll').scrollTop=readingPositions.get(current)||0;
  $('#readerScroll').setAttribute('aria-label','Текст выступления: '+speech[current].title);
 }
 requestAnimationFrame(updateReadingProgress);
}
function setReaderVisible(value){
 readerVisible=value;document.body.dataset.reader=String(value);syncNotes();syncReader();requestStageFit();
}
function fitStage(){
 fitPending=false;
 const top=$('.topbar').getBoundingClientRect().height,bottom=$('.bottom').getBoundingClientRect().height;
 document.documentElement.style.setProperty('--workspace-top',top+'px');
 document.documentElement.style.setProperty('--workspace-bottom',bottom+'px');
 if(flow)return;
 const viewport=slides[current].querySelector('.stage-viewport'),canvas=slides[current].querySelector('.stage-canvas');
 const availableWidth=viewport.clientWidth,availableHeight=viewport.clientHeight;
 if(!availableWidth||!availableHeight)return;
 const baseWidth=Math.max(720,Math.min(1100,availableWidth));
 canvas.style.width=baseWidth+'px';
 const naturalHeight=canvas.offsetHeight;
 if(!naturalHeight)return;
 const scale=Math.min(1,availableWidth/baseWidth,availableHeight/naturalHeight);
 canvas.style.transform='translate(-50%,-50%) scale('+scale.toFixed(4)+')';
}
function requestStageFit(){if(!fitPending){fitPending=true;requestAnimationFrame(fitStage)}}
$('#fontDown').addEventListener('click',()=>{readerFont=Math.max(16,readerFont-1);applyReaderSettings();saveReaderSettings()});
$('#fontUp').addEventListener('click',()=>{readerFont=Math.min(30,readerFont+1);applyReaderSettings();saveReaderSettings()});
$('#readerWidth').addEventListener('input',()=>{readerShare=Number($('#readerWidth').value);applyReaderSettings();saveReaderSettings()});
$('#readerStart').addEventListener('click',()=>{$('#readerScroll').scrollTop=0;updateReadingProgress();$('#readerScroll').focus({preventScroll:true})});
$('#readerScroll').addEventListener('scroll',updateReadingProgress,{passive:true});
window.addEventListener('resize',requestStageFit);
document.addEventListener('fullscreenchange',requestStageFit);
$$('.stage-extras').forEach(el=>el.addEventListener('toggle',requestStageFit));
if(typeof ResizeObserver!=='undefined'){
 const fitObserver=new ResizeObserver(requestStageFit);
 fitObserver.observe($('.topbar'));fitObserver.observe($('.bottom'));fitObserver.observe($('#workspace'));
 $$('.stage-viewport').forEach(el=>fitObserver.observe(el));
 $$('.stage-canvas').forEach(el=>fitObserver.observe(el));
 const readerObserver=new ResizeObserver(updateReadingProgress);readerObserver.observe($('#readerScroll'));
}
// Also supports browsers without ResizeObserver after an interactive diagram changes.
$$('.stage-canvas button').forEach(b=>b.addEventListener('click',requestStageFit));
applyReaderSettings();

const initial=location.hash.match(/^#block-(\d+)$/);go(initial?+initial[1]-1:0,false);
})();
</script>
